#!/usr/bin/env bash
set -euo pipefail
started=0
if ! pgrep -x transmission-daemon >/dev/null 2>&1; then
  transmission-daemon
  started=1
  for _ in $(seq 1 30); do
    transmission-remote -l >/dev/null 2>&1 && break
    sleep 0.1
  done
fi
cleanup() {
  if [ "$started" -eq 1 ]; then transmission-remote --exit >/dev/null 2>&1 || true; fi
}
trap cleanup EXIT INT TERM

tremc
