#!/usr/bin/env bash
set -euo pipefail
ws="$(swaymsg -t get_workspaces -r 2>/dev/null | jq -r '.[] | select(.focused) | .num' | head -1)"
[ -n "$ws" ] || ws='?'
bat='--'
for b in /sys/class/power_supply/BAT*; do
  [ -r "$b/capacity" ] || continue
  v="$(cat "$b/capacity")"
  if [ "$bat" = '--' ]; then bat="$v"; else bat=$(( (bat + v) / 2 )); fi
done
read -r used total < <(free -m | awk '/^Mem:/ {printf "%.1f %.1f\n", $3/1024, $2/1024}')
printf '%s  bat %s%%  mem %s/%sG\n' "$ws" "$bat" "$used" "$total"
